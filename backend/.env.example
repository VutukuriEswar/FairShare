# FairShare config — copy to .env and fill in. See README Configuration Details.
# Local SQLite storage — data stays with whoever hosts the backend.
DATA_DIR=./data
SQLITE_PATH=./data/fairshare.db
# Secret for signing JWTs (required in production)
JWT_SECRET=change-me-to-a-long-random-secret
# JWT lifetime in minutes
JWT_EXPIRE_MINUTES=10080
# Comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000
# Public URL of the frontend (used in invite emails)
FRONTEND_URL=http://localhost:3000
# Backend port
PORT=8000
# SMTP for invite emails (optional; console fallback if empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FairShare <noreply@fairshare.local>
SMTP_USE_TLS=true
# GitHub personal access token (optional, raises rate limit)
GITHUB_TOKEN=
# GitHub OAuth app (optional; manual login linking is the fallback)
# Create at https://github.com/settings/developers -> OAuth App.
# Authorization callback URL must be GITHUB_OAUTH_REDIRECT below.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Where GitHub redirects after authorize (must match OAuth app + frontend route /auth/callback)
GITHUB_OAUTH_REDIRECT=http://localhost:3000/auth/callback
# Hours before a weekly summary auto-shares
GRACE_HOURS_AUTOSHARE=48
